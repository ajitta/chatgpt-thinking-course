  "components": [
    {
      "name": "Solid Button",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "실행 버튼과 홈의 \"1강부터 읽기\". 화면마다 하나의 주 동작.",
      "html": "<button class=\"ds-btn-solid\">1강부터 읽기</button>",
      "css": ".ds-btn-solid{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:46px;padding:9px 18px;font:inherit;font-size:16px;font-weight:650;line-height:1.4;border-radius:5px;border:1px solid var(--accent,#216044);background:var(--accent,#216044);color:#fff;cursor:pointer;transition:background-color .15s ease-out,color .15s ease-out}.ds-btn-solid:hover{background:var(--accent-strong,#16442f)}.ds-btn-solid:active{transform:translateY(1px)}.ds-btn-solid:focus-visible{outline:3px solid var(--focus,#805700);outline-offset:3px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "보조 동작(다시 하기, 복사).",
      "html": "<button class=\"ds-btn-outline\">다시 풀기</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:9px 18px;font:inherit;font-size:16px;font-weight:650;line-height:1.4;border-radius:5px;border:1px solid var(--accent,#216044);background:var(--bg-1,#fff);color:var(--accent,#216044);cursor:pointer;transition:background-color .15s ease-out}.ds-btn-outline:hover{background:var(--accent-tint,#e7f0e8)}.ds-btn-outline:active{transform:translateY(1px)}.ds-btn-outline:focus-visible{outline:3px solid var(--focus,#805700);outline-offset:3px}"
    },
    {
      "name": "Choice",
      "kind": "input",
      "refersTo": "choice",
      "description": "원문 선택 문제의 라디오 선택지. 선택되면 녹색 테두리와 연녹 면.",
      "html": "<label class=\"ds-choice\"><input type=\"radio\" name=\"ds-q\" checked><span>다음 토큰을 확률로 고른다</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-q\"><span>정답을 검색해서 붙인다</span></label>",
      "css": ".ds-choice{display:flex;align-items:flex-start;gap:12px;padding:11px 14px;margin:0 0 8px;border:1px solid var(--line,#758477);border-radius:5px;background:var(--bg-1,#fff);cursor:pointer;font-size:17px;line-height:1.6;color:var(--ink,#182720)}.ds-choice:hover{background:#f4f6f1}.ds-choice:has(input:checked){border-color:var(--accent,#216044);box-shadow:inset 0 0 0 1px var(--accent,#216044);background:var(--accent-tint,#e7f0e8)}.ds-choice input{accent-color:var(--accent,#216044);width:19px;height:19px;margin:4px 0 0;flex:none}.ds-choice input:focus-visible{outline:3px solid var(--focus,#805700);outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "직접 적어 보기 입력란. 입력은 저장하지 않음.",
      "html": "<textarea class=\"ds-field\" rows=\"3\" placeholder=\"내 말로 적어 보세요\"></textarea>",
      "css": ".ds-field{width:100%;font:inherit;font-size:16px;line-height:1.6;color:var(--ink,#182720);background:var(--bg-1,#fff);border:1px solid var(--line,#758477);border-radius:5px;padding:10px 12px;resize:vertical}.ds-field:focus{border-color:var(--accent,#216044);outline:3px solid var(--focus,#805700);outline-offset:1px}"
    },
    {
      "name": "Segmented Control",
      "kind": "input",
      "refersTo": "choice",
      "description": "원문의 구간 선택. 선택된 칸은 녹색 채움.",
      "html": "<div class=\"ds-seg\"><label class=\"ds-seg-item\"><input type=\"radio\" name=\"ds-s\" checked><span>짧게</span></label><label class=\"ds-seg-item\"><input type=\"radio\" name=\"ds-s\"><span>길게</span></label></div>",
      "css": ".ds-seg{display:flex;border:1px solid var(--line,#758477);border-radius:6px;padding:3px;background:var(--bg-1,#fff)}.ds-seg-item{flex:1 1 0;position:relative;cursor:pointer}.ds-seg-item input{position:absolute;opacity:0;inset:0;margin:0}.ds-seg-item span{display:block;padding:8px 14px;border-radius:4px;text-align:center;font-size:16px;font-weight:600;color:var(--muted,#48564d)}.ds-seg-item input:checked+span{background:var(--accent,#216044);color:#fff}.ds-seg-item input:focus-visible+span{outline:3px solid var(--focus,#805700);outline-offset:2px}.ds-seg-item:hover input:not(:checked)+span{background:var(--bg-2,#f0f2ec);color:var(--ink,#182720)}"
    },
    {
      "name": "Badge",
      "kind": "chip",
      "refersTo": "badge-info",
      "description": "원문 배지. 알약형은 배지와 출처 표기에만.",
      "html": "<span class=\"ds-badge\">기본</span> <span class=\"ds-badge ds-badge-info\">정보</span> <span class=\"ds-badge ds-badge-secondary\">보조</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 10px;border-radius:999px;background:var(--bg-3,#e1e7df);color:var(--ink,#182720);font-size:14px;font-weight:600;line-height:1.6;white-space:nowrap}.ds-badge-info{background:var(--accent-tint,#e7f0e8);color:var(--accent-strong,#16442f)}.ds-badge-secondary{background:transparent;color:var(--muted,#48564d);box-shadow:inset 0 0 0 1px var(--rule-strong,#b9c3b9)}"
    },
    {
      "name": "Unit Opener",
      "kind": "custom",
      "refersTo": "unit-row",
      "description": "과정 홈의 부. 2px 잉크 선 위에 부 이름과 범위, 녹색 번호의 강의 행.",
      "html": "<section class=\"ds-unit\"><div class=\"ds-unit-head\"><h2>AI의 기본 원리</h2><p>1–4강</p></div><ol><li><a href=\"#\"><span class=\"ds-no\">1강</span><span class=\"ds-ttl\">ChatGPT는 어떻게 답을 만들까</span></a></li><li><a href=\"#\"><span class=\"ds-no\">2강</span><span class=\"ds-ttl\">토큰과 확률</span></a></li></ol></section>",
      "css": ".ds-unit{border-top:2px solid var(--ink,#182720);padding-top:16px;color:var(--ink,#182720)}.ds-unit-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px}.ds-unit-head h2{margin:0;font-size:25px;line-height:1.4;letter-spacing:-0.03em;font-weight:750}.ds-unit-head p{margin:0;font-size:15px;color:var(--muted,#48564d);font-variant-numeric:tabular-nums}.ds-unit ol{list-style:none;margin:10px 0 0;padding:0}.ds-unit a{display:grid;grid-template-columns:60px minmax(0,1fr);gap:8px;align-items:baseline;padding:14px 8px 14px 0;border-bottom:1px solid var(--rule,#d4dbd3);color:inherit;text-decoration:none;transition:background-color .15s ease-out}.ds-no{color:var(--accent,#216044);font-weight:750;font-size:16px;font-variant-numeric:tabular-nums}.ds-ttl{font-size:19px;line-height:1.55;font-weight:600;letter-spacing:-0.015em}.ds-unit a:hover{background:var(--accent-tint,#e7f0e8)}.ds-unit a:hover .ds-ttl{text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--accent,#216044)}.ds-unit a:focus-visible{outline:3px solid var(--focus,#805700);outline-offset:3px}"
    },
